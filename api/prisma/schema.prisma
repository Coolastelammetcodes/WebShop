generator client {
  provider = "prisma-client"
  output   = "../src/data/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Mug {
  id          Int    @id @default(autoincrement())
  name        String
  description String @default("")
  filepath    String @default("")
  price       Float  @default(0)
}
